# Bootstrap admin username
COINWATCH_ADMIN_USER=
# Bootstrap admin password
COINWATCH_ADMIN_PASSWORD=
# SQLite database URL
DATABASE_URL=sqlite:///data/coinwatch.db
# Solana JSON-RPC endpoint. Empty disables the coin poller.
SOLANA_RPC_URL=
# SOL price in USD for tick market cap. Empty disables the coin poller.
COINWATCH_SOL_USD=
# Hot wallet private key
SOLANA_HOT_WALLET_KEY=
# Inference provider name
INFERENCE_PROVIDER=
# Digest model identifier
INFERENCE_MODEL_DIGEST=
# Escalation model identifier
INFERENCE_MODEL_ESCALATION=
# Review model identifier
INFERENCE_MODEL_REVIEW=
# OpenAI API key
OPENAI_API_KEY=
# Anthropic API key
ANTHROPIC_API_KEY=
# LM Studio base URL
LMSTUDIO_BASE_URL=
# Log inference prompts when true
LOG_INFERENCE_PROMPTS=
# Reject new quotes when true
COINWATCH_KILL_SWITCH=
# signal-cli executable used to send alerts
SIGNAL_CLI_BIN=signal-cli
# signal-cli account linked on boblab
SIGNAL_ACCOUNT=+14075150936
# Recipient for the Signal test alert
SIGNAL_RECIPIENT=+14075150936
